{
  "version": 2,
  "profile": "delivery",
  "name": "limbus-translation-test",
  "description": "Run tests via workflow",
  "entry": "test",
  "limits": {
    "max_total_steps": 20,
    "max_visits_per_node": 4,
    "command_timeout_seconds": 600,
    "agent_timeout_seconds": 1800
  },
  "nodes": [
    {
      "id": "test",
      "type": "command",
      "title": "Run Tests",
      "description": "Run python unittests",
      "actions": [
        {
          "name": "Unittest",
          "type": "command",
          "command": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        }
      ],
      "gates": [],
      "on": {
        "passed": "$complete",
        "failed": "$failed"
      }
    }
  ],
  "agent": {
    "backend": "codex-sdk",
    "sandbox": "workspace-write",
    "approval_mode": "deny_all"
  }
}
