#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_root="$repo_root/.dev-workflow"
requirements="$runtime_root/requirements.txt"
sdk_python="$runtime_root/.venv/bin/python"
requirements_stamp="$runtime_root/.venv/.requirements-installed"
bootstrap_lock="$runtime_root/.venv-bootstrap.lock"
bootstrap_python=${DEV_WORKFLOW_PYTHON:-python3}

if [ ! -x "$sdk_python" ] || [ ! -f "$requirements_stamp" ] || ! cmp -s "$requirements" "$requirements_stamp"; then
  "$bootstrap_python" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' || {
    echo "dev-workflow requires Python 3.10 or later" >&2
    exit 2
  }
  if ! mkdir "$bootstrap_lock" 2>/dev/null; then
    echo "another dev-workflow SDK bootstrap is active: $bootstrap_lock" >&2
    exit 2
  fi
  trap 'rmdir "$bootstrap_lock" 2>/dev/null || true' EXIT INT TERM
  if [ ! -x "$sdk_python" ]; then
    "$bootstrap_python" -m venv "$runtime_root/.venv"
  fi
  "$sdk_python" -m pip install --disable-pip-version-check --no-input -r "$requirements"
  cp "$requirements" "$requirements_stamp.new"
  mv "$requirements_stamp.new" "$requirements_stamp"
  rmdir "$bootstrap_lock"
  trap - EXIT INT TERM
fi

command_name=${1:-}
if [ -z "$command_name" ]; then
  exec "$sdk_python" "$runtime_root/run.py" --help
fi
shift
case "$command_name" in
  validate|start|visualize)
    exec "$sdk_python" "$runtime_root/run.py" "$command_name" --workflow "$repo_root/workflow.json" "$@"
    ;;
  *)
    exec "$sdk_python" "$runtime_root/run.py" "$command_name" "$@"
    ;;
esac
